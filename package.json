{
  "name": "bm-starterkit-be",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS monorepo starterkit: api-gateway (BFF) + api-services (master data)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm build:gateway && pnpm build:services",
    "build:gateway": "nest build api-gateway && tsc-alias -p apps/api-gateway/tsconfig.app.json",
    "build:services": "nest build api-services && tsc-alias -p apps/api-services/tsconfig.app.json",
    "start:gateway": "node --max-http-header-size=32768 dist/apps/api-gateway/apps/api-gateway/src/main.js",
    "start:services": "node dist/apps/api-services/apps/api-services/src/main.js",
    "start:gateway:dev": "nest start api-gateway --watch",
    "start:services:dev": "nest start api-services --watch",
    "prisma:pull": "prisma db pull --schema=apps/api-services/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=apps/api-services/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=apps/api-services/prisma/schema.prisma",
    "generate:keys": "node scripts/generate-keys.mjs",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "standard-version"
  },
  "dependencies": {
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
